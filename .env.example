# MCP Telegram Configuration
# Copy this file to .env and fill in your values

# Telegram API Credentials
# Get from https://my.telegram.org/apps
API_ID=your_api_id
API_HASH=your_api_hash

# Database Configuration
DB_USER=mcp
DB_PASSWORD=mcp_secret_change_me
DB_NAME=mcp_telegram
DB_PORT=5432

# Daemon Configuration
DAEMON_PORT=8765

# MCP HTTP transport (for Dify and other HTTP-based MCP clients).
# Transport: stdio (default, for Claude Desktop/Code), sse, streamable-http.
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8766
# Bearer token required by HTTP transports. SET A LONG RANDOM SECRET before
# exposing the server publicly — anyone with this token can use your Telegram.
MCP_AUTH_TOKEN=change_me_to_a_long_random_secret
# Host validation: FastMCP only allows localhost by default (returns 421 for
# anything else). List the Host header(s) clients will use (public domain or
# container name), or set MCP_DISABLE_HOST_VALIDATION=true to drop the check.
MCP_ALLOWED_HOSTS=mcp.example.com:*
MCP_DISABLE_HOST_VALIDATION=false

# Full database URL (auto-constructed if not set)
# DATABASE_URL=postgresql://mcp:password@localhost:5432/mcp_telegram
